rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function user() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function googleIdentity() {
      return signedIn()
        && request.auth.token.firebase.get('identities', {}).keys()
          .hasAny([
            'google.com'
          ]);
    }
    function googleVerified(userId) {
      return exists(/databases/$(database)/documents/userAuth/$(userId))
        && get(/databases/$(database)/documents/userAuth/$(userId)).data.provider
          == 'google.com';
    }
    function enabled(data) {
      return data.get('disabled', false) == false;
    }
    function active() {
      return signedIn()
        && googleIdentity()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && user().data.status == 'active'
        && enabled(user().data);
    }
    function admin() {
      return active()
        && user().data.role == 'admin'
        && googleIdentity();
    }
    function validCurrency(currency) {
      return currency is string && currency.matches('^[A-Z]{3}$');
    }
    function legacyAllowedCurrency(currency) {
      return currency == 'TWD';
    }
    function hasCurrencyAllowlist() {
      return exists(/databases/$(database)/documents/settings/app)
        && get(/databases/$(database)/documents/settings/app).data.keys()
          .hasAll(['allowedCurrencies']);
    }
    function currencyAllowedBySettings(currency) {
      return get(/databases/$(database)/documents/settings/app).data.allowedCurrencies is list
        && currency in get(/databases/$(database)/documents/settings/app).data.allowedCurrencies;
    }
    function allowedCurrency(currency) {
      return validCurrency(currency)
        && (
          (!hasCurrencyAllowlist() && legacyAllowedCurrency(currency))
          || (hasCurrencyAllowlist() && currencyAllowedBySettings(currency))
        );
    }
    function validAlias(alias) {
      return alias is string && alias.size() > 0 && alias.size() <= 40;
    }
    function validUserCurrencySettings(data) {
      return (!data.keys().hasAll(['resultCurrency'])
          || allowedCurrency(data.resultCurrency))
        && (!data.keys().hasAll(['currencyRates'])
          || data.currencyRates is map);
    }
    function validUserFlags(data) {
      return data.get('disabled', false) is bool
        && data.get('ledgerSelectable', true) is bool;
    }
    function validUserStatus(status) {
      return status == 'pending'
        || status == 'active'
        || status == 'rejected'
        || status == 'removed';
    }
    function validAdminStatusTransition(data, existingData) {
      return data.status == existingData.status
        || (existingData.status == 'pending'
          && (
            data.status == 'active'
            || data.status == 'rejected'
          ))
        || (existingData.status == 'rejected'
          && data.status == 'active')
        || (existingData.status == 'removed'
          && data.status == 'active');
    }
    function validAdminRole(userId, data, existingData) {
      return data.role == 'user'
        || (
          data.role == 'admin'
          && data.status == 'active'
          && (
            existingData.role == 'admin'
            || googleVerified(userId)
          )
        );
    }
    function validAdminUserUpdate(userId, data, existingData) {
      let affectedKeys = data.diff(existingData).affectedKeys();
      return affectedKeys.hasOnly([
          'disabled',
          'ledgerSelectable',
          'role',
          'status',
          'updatedAt'
        ])
        && validAdminRole(userId, data, existingData)
        && validUserStatus(data.status)
        && validUserFlags(data)
        && validAdminStatusTransition(data, existingData)
        && (data.status != 'removed' || existingData.status == 'removed')
        && data.updatedAt == request.time
        && (
          userId != request.auth.uid
          || !affectedKeys.hasAny([
            'disabled',
            'role',
            'status'
          ])
        );
    }
    function validAdminRemoval(data, existingData) {
      return existingData.status == 'active'
        && data.status == 'removed'
        && data.role == 'user'
        && data.get('disabled', false) == false
        && data.email == ''
        && data.photoURL == ''
        && data.currencyRates is map
        && data.currencyRates.size() == 0
        && validUserFlags(data)
        && data.updatedAt == request.time
        && data.diff(existingData).affectedKeys().hasOnly([
          'currencyRates',
          'disabled',
          'email',
          'photoURL',
          'role',
          'status',
          'updatedAt'
        ]);
    }
    function activeUser(userId) {
      let ledgerUser = get(
        /databases/$(database)/documents/users/$(userId)
      );
      return ledgerUser.data.status == 'active';
    }
    function selectableLedgerUser(userId) {
      let ledgerUser = get(
        /databases/$(database)/documents/users/$(userId)
      );
      return ledgerUser.data.status == 'active'
        && enabled(ledgerUser.data)
        && ledgerUser.data.get('ledgerSelectable', true) == true;
    }
    function visibleLedgerUser(data) {
      return data.status == 'active' || data.status == 'removed';
    }
    function historicalLedgerUser(userId) {
      return userId is string
        && exists(
          /databases/$(database)/documents/users/$(userId)
        )
        && visibleLedgerUser(
          get(
            /databases/$(database)/documents/users/$(userId)
          ).data
        );
    }
    function retainedLedgerUser(userId, existingUserId) {
      let ledgerUser = get(
        /databases/$(database)/documents/users/$(userId)
      );
      return userId == existingUserId
        && ledgerUser.data.status == 'removed';
    }
    function validLedgerHeaderKeys(data) {
      return data.keys().hasOnly([
          'creditorId',
          'createdAt',
          'createdBy',
          'currency',
          'note',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'creditorId',
          'createdAt',
          'createdBy',
          'currency',
          'note',
          'updatedAt'
        ]);
    }
    function validLedgerHeaderCreate(data) {
      return validLedgerHeaderKeys(data)
        && data.creditorId is string
        && allowedCurrency(data.currency)
        && data.note is string
        && data.note.size() <= 160
        && (
          (
            data.createdBy == request.auth.uid
            && selectableLedgerUser(data.creditorId)
            && data.createdAt == request.time
            && data.updatedAt == request.time
          )
          || (
            admin()
            && historicalLedgerUser(data.createdBy)
            && historicalLedgerUser(data.creditorId)
            && data.createdAt is timestamp
            && data.updatedAt is timestamp
          )
        );
    }
    function validLedgerHeaderUpdate(data, existingData) {
      return validLedgerHeaderKeys(data)
        && data.createdBy == existingData.createdBy
        && data.creditorId == existingData.creditorId
        && data.createdAt == existingData.createdAt
        && (
          activeUser(data.creditorId)
          || retainedLedgerUser(data.creditorId, existingData.creditorId)
        )
        && allowedCurrency(data.currency)
        && data.note is string
        && data.note.size() <= 160
        && data.updatedAt == request.time
        && data.diff(existingData).affectedKeys().hasOnly([
          'currency',
          'note',
          'updatedAt'
        ]);
    }
    function validLedgerSplitKeys(data) {
      return data.keys().hasOnly([
          'amount',
          'cleared',
          'createdAt',
          'debtorId',
          'ledgerId',
          'position',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'amount',
          'cleared',
          'createdAt',
          'debtorId',
          'ledgerId',
          'position',
          'updatedAt'
        ]);
    }
    function validLedgerSplitValues(data) {
      return data.amount is number
        && data.amount > 0
        && data.cleared is bool
        && data.position is int
        && data.position >= 0;
    }
    function ledgerOwnedBefore(ledgerId) {
      return ledgerId is string
        && exists(/databases/$(database)/documents/ledger/$(ledgerId))
        && get(/databases/$(database)/documents/ledger/$(ledgerId)).data.createdBy
          == request.auth.uid;
    }
    function ledgerManagedAfter(ledgerId) {
      return ledgerId is string
        && existsAfter(/databases/$(database)/documents/ledger/$(ledgerId))
        && (
          admin()
          || getAfter(
            /databases/$(database)/documents/ledger/$(ledgerId)
          ).data.createdBy == request.auth.uid
        );
    }

    match /users/{userId} {
      allow create: if (googleIdentity() && request.auth.uid == userId
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'user'
        && validAlias(request.resource.data.alias)
        && allowedCurrency(request.resource.data.resultCurrency)
        && validUserFlags(request.resource.data)
        && request.resource.data.get('disabled', false) == false
        && request.resource.data.get('ledgerSelectable', true) == true)
        || (admin()
        && request.resource.data.status == 'active'
        && request.resource.data.role == 'user'
        && validAlias(request.resource.data.alias)
        && allowedCurrency(request.resource.data.resultCurrency)
        && validUserFlags(request.resource.data)
        && request.resource.data.get('disabled', false) == false
        && request.resource.data.get('ledgerSelectable', true) == true);
      allow get: if (signedIn() && request.auth.uid == userId)
        || admin()
        || (active() && visibleLedgerUser(resource.data));
      allow list: if admin()
        || (active() && visibleLedgerUser(resource.data));
      allow update: if (admin()
          && (
            validAdminUserUpdate(
              userId,
              request.resource.data,
              resource.data
            )
            || (
              userId != request.auth.uid
              && validAdminRemoval(
                request.resource.data,
                resource.data
              )
            )
          ))
        || (signedIn() && request.auth.uid == userId
          && resource.data.status != 'removed'
          && enabled(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'alias',
              'currencyRates',
              'resultCurrency',
              'updatedAt'
            ])
          && validAlias(request.resource.data.alias)
          && validUserCurrencySettings(request.resource.data));
      allow delete: if admin()
        && request.auth.uid != userId
        && resource.data.role == 'user'
        && (
          resource.data.status == 'pending'
          || resource.data.status == 'rejected'
          || resource.data.status == 'removed'
        );
    }
    match /userAuth/{userId} {
      allow get: if (signedIn() && request.auth.uid == userId)
        || admin();
      allow list: if admin();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && googleIdentity()
        && request.resource.data.keys().hasOnly([
          'provider'
        ])
        && request.resource.data.provider == 'google.com';
      allow delete: if false;
    }
    match /settings/{settingId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update, delete: if admin();
    }
    match /ledger/{entryId} {
      allow read: if active();
      allow create: if active()
        && validLedgerHeaderCreate(request.resource.data);
      allow update: if active()
        && (admin() || resource.data.createdBy == request.auth.uid)
        && validLedgerHeaderUpdate(request.resource.data, resource.data);
      allow delete: if active()
        && (resource.data.createdBy == request.auth.uid || admin());
    }
    match /ledgerSplits/{splitId} {
      allow read: if active();
      allow create: if active()
        && validLedgerSplitKeys(request.resource.data)
        && validLedgerSplitValues(request.resource.data)
        && request.resource.data.ledgerId is string
        && request.resource.data.debtorId is string
        && splitId == request.resource.data.ledgerId
          + '_'
          + request.resource.data.debtorId
        && ledgerManagedAfter(request.resource.data.ledgerId)
        && request.resource.data.debtorId != getAfter(
          /databases/$(database)/documents/ledger/$(request.resource.data.ledgerId)
        ).data.creditorId
        && (
          (
            selectableLedgerUser(request.resource.data.debtorId)
            && selectableLedgerUser(
              getAfter(
                /databases/$(database)/documents/ledger/$(request.resource.data.ledgerId)
              ).data.creditorId
            )
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
          )
          || (
            admin()
            && historicalLedgerUser(request.resource.data.debtorId)
            && historicalLedgerUser(
              getAfter(
                /databases/$(database)/documents/ledger/$(request.resource.data.ledgerId)
              ).data.creditorId
            )
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp
          )
        );
      allow update: if active()
        && validLedgerSplitKeys(request.resource.data)
        && validLedgerSplitValues(request.resource.data)
        && request.resource.data.ledgerId == resource.data.ledgerId
        && request.resource.data.debtorId == resource.data.debtorId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'amount',
          'cleared',
          'position',
          'updatedAt'
        ])
        && ledgerManagedAfter(resource.data.ledgerId)
        && (
          activeUser(request.resource.data.debtorId)
          || retainedLedgerUser(
            request.resource.data.debtorId,
            resource.data.debtorId
          )
        )
        && request.resource.data.debtorId != getAfter(
          /databases/$(database)/documents/ledger/$(resource.data.ledgerId)
        ).data.creditorId;
      allow delete: if active()
        && (admin() || ledgerOwnedBefore(resource.data.ledgerId));
    }
    match /ledgerImages/{imageId} {
      allow read: if active();
      allow create: if active()
        && request.resource.data.keys().hasOnly([
          'createdAt',
          'createdBy',
          'dataUrl',
          'ledgerId'
        ])
        && request.resource.data.keys().hasAll([
          'createdAt',
          'createdBy',
          'dataUrl',
          'ledgerId'
        ])
        && request.resource.data.ledgerId is string
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 700000
        && ledgerManagedAfter(request.resource.data.ledgerId)
        && (
          (
            request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time
          )
          || (
            admin()
            && historicalLedgerUser(request.resource.data.createdBy)
            && request.resource.data.createdAt is timestamp
          )
        );
      allow delete: if active()
        && (
          admin()
          || ledgerOwnedBefore(resource.data.get('ledgerId', ''))
        );
    }
  }
}
